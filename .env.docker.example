# Docker runtime settings.
#
# Copy to `.env.docker` or export these in your shell before `docker compose`.
# Do not commit real API keys.

# Optional: keep this blank unless you want Groq models in the dashboard.
# Compose maps this to GROQ_KEY inside the backend container.
DOCKER_GROQ_KEY=

# Optional: override where Docker should mount your LM Studio model files from.
# Windows example:
LMSTUDIO_MODELS=C:/Users/husna/.lmstudio/models

# Optional: exact GGUF paths inside the container for the LFM aliases.
# These paths must be under /lm-models because that is where LMSTUDIO_MODELS is mounted.
# LFM_350M_GGUF=/lm-models/publisher/model/lfm2-350m-q4_k_m.gguf
# LFM_12B_GGUF=/lm-models/publisher/model/lfm2-1.2b-q4_k_m.gguf
