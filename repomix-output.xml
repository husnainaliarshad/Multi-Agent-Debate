# graphs.py
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import os

# Load data
df = pd.read_csv("benchmark_full_study_results.csv")
os.makedirs("figures", exist_ok=True)

# Set style
sns.set_style("whitegrid")
plt.rcParams['figure.figsize'] = (10, 6)
plt.rcParams['font.size'] = 11

# Separate legal and KNK
legal_df = df[df["benchmark_type"] == "legal_reasoning"]
knk_df = df[df["benchmark_type"] == "knk"]

# ========== 1. Legal: Consensus by config and rounds ==========
plt.figure()
sns.boxplot(data=legal_df, x="config", y="consensus_score", hue="rounds", 
            order=["single_agent", "self_critique", "multi_proposer"])
plt.title("Legal Reasoning Consensus Score by Configuration and Rounds")
plt.ylabel("Consensus Score (%)")
plt.xlabel("Configuration")
plt.legend(title="Rounds")
plt.tight_layout()
plt.savefig("figures/legal_consensus_by_config.png", dpi=150)
plt.close()

# ========== 2. KNK: Accuracy by config and rounds ==========
plt.figure()
sns.boxplot(data=knk_df, x="config", y="consensus_score", hue="rounds",
            order=["single_agent", "self_critique", "multi_proposer"])
plt.title("KNK Puzzle Accuracy by Configuration and Rounds")
plt.ylabel("Accuracy (%)")
plt.xlabel("Configuration")
plt.legend(title="Rounds")
plt.tight_layout()
plt.savefig("figures/knk_accuracy_by_config.png", dpi=150)
plt.close()

# ========== 3. Model comparison (legal consensus) ==========
plt.figure()
sns.barplot(data=legal_df, x="model_display", y="consensus_score", hue="config",
            order=["LFM 350M", "Qwen 0.5B", "Llama 3.2 1B", "LFM 1.2B"])
plt.title("Legal Consensus by Model and Configuration")
plt.ylabel("Consensus Score (%)")
plt.xlabel("Model")
plt.xticks(rotation=45)
plt.legend(title="Config", bbox_to_anchor=(1.05, 1))
plt.tight_layout()
plt.savefig("figures/model_legal_comparison.png", dpi=150)
plt.close()

# ========== 4. Latency vs Quality trade-off ==========
# Use only round=2 for clarity
df_r2 = df[df["rounds"] == 2]
plt.figure()
sns.scatterplot(data=df_r2, x="duration_seconds", y="consensus_score", 
                hue="config", style="benchmark_type", s=80, alpha=0.7)
plt.title("Quality vs Latency Trade-off (2 rounds)")
plt.xlabel("Latency (seconds)")
plt.ylabel("Consensus / Accuracy (%)")
plt.legend(bbox_to_anchor=(1.05, 1))
plt.tight_layout()
plt.savefig("figures/latency_quality_tradeoff.png", dpi=150)
plt.close()

# ========== 5. Rounds effect heatmap (legal only) ==========
rounds_effect = legal_df.groupby(["rounds", "config"])["consensus_score"].mean().unstack()
plt.figure()
sns.heatmap(rounds_effect, annot=True, fmt=".1f", cmap="YlOrRd", cbar_kws={'label': 'Consensus Score (%)'})
plt.title("Legal Consensus: Rounds × Config Heatmap")
plt.tight_layout()
plt.savefig("figures/rounds_effect_heatmap.png", dpi=150)
plt.close()

# ========== 6. KNK accuracy by model ==========
plt.figure()
sns.barplot(data=knk_df, x="model_display", y="consensus_score", hue="config",
            order=["LFM 350M", "Qwen 0.5B", "Llama 3.2 1B", "LFM 1.2B"])
plt.title("KNK Accuracy by Model and Configuration")
plt.ylabel("Accuracy (%)")
plt.xlabel("Model")
plt.xticks(rotation=45)
plt.legend(title="Config", bbox_to_anchor=(1.05, 1))
plt.tight_layout()
plt.savefig("figures/knk_accuracy_by_model.png", dpi=150)
plt.close()

# ========== 7. SPB score (position-swap bias) by config ==========
plt.figure()
sns.boxplot(data=df, x="config", y="spb_score", hue="rounds",
            order=["single_agent", "self_critique", "multi_proposer"])
plt.title("Position-Swap Bias (SPB) by Configuration and Rounds")
plt.ylabel("SPB Score (lower is better)")
plt.xlabel("Configuration")
plt.legend(title="Rounds")
plt.tight_layout()
plt.savefig("figures/spb_by_config.png", dpi=150)
plt.close()

# ========== 8. Faithfulness by config and rounds ==========
plt.figure()
sns.boxplot(data=legal_df, x="config", y="faithfulness", hue="rounds",
            order=["single_agent", "self_critique", "multi_proposer"])
plt.title("Faithfulness (Grounding) by Configuration and Rounds")
plt.ylabel("Faithfulness Score")
plt.xlabel("Configuration")
plt.legend(title="Rounds")
plt.tight_layout()
plt.savefig("figures/faithfulness_by_config.png", dpi=150)
plt.close()

print("All 8 figures generated in 'figures/'")
