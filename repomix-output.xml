import pandas as pd
import numpy as np

# Load data
df = pd.read_csv("realistic_benchmarking_experiment_450.csv")
df['round'] = df['mode'].str.extract(r'(\d+)').astype(int)

# Map model names
model_names = {
    'lfm2.5-350m': 'LFM 350M',
    'qwen2.5-0.5b-instruct': 'Qwen 0.5B',
    'llama3.2-1b-instruct': 'Llama 3.2 1B'
}
df['model_short'] = df['proposer_model'].map(model_names)

# ------------------------------------------------------------
# Table 1: Mean ± std by model and round
# ------------------------------------------------------------
table1 = df.groupby(['model_short', 'round']).agg(
    Consensus=('consensus_score', lambda x: f"{x.mean():.1f} ± {x.std():.1f}"),
    Faithfulness=('faithfulness', lambda x: f"{x.mean():.3f} ± {x.std():.3f}"),
    Latency_s=('duration_seconds', lambda x: f"{x.mean():.1f} ± {x.std():.1f}")
).reset_index()

print("\n## Table 1: Performance by Model and Debate Round\n")
print(table1.to_markdown(index=False))

# ------------------------------------------------------------
# Table 2: Improvement from round 1 to round 3
# ------------------------------------------------------------
r1 = df[df['round']==1].groupby('model_short')[['consensus_score','faithfulness']].mean()
r3 = df[df['round']==3].groupby('model_short')[['consensus_score','faithfulness']].mean()
gain = r3 - r1
gain_pct = (gain / r1) * 100

improvement = pd.DataFrame({
    'Model': r1.index,
    'Consensus R1 (%)': r1['consensus_score'].round(1),
    'Consensus R3 (%)': r3['consensus_score'].round(1),
    'Gain (pp)': gain['consensus_score'].round(1),
    'Gain (%)': gain_pct['consensus_score'].round(1),
    'Faithfulness R1': r1['faithfulness'].round(3),
    'Faithfulness R3': r3['faithfulness'].round(3),
    'Gain (abs)': gain['faithfulness'].round(3),
    'Gain (%)': gain_pct['faithfulness'].round(1)
})
print("\n## Table 2: Improvement from 1‑Round to 3‑Round Debate\n")
print(improvement.to_markdown(index=False))

# ------------------------------------------------------------
# Table 3: Top 5 and Bottom 5 Topics by Round‑3 Consensus
# ------------------------------------------------------------
df_r3 = df[df['round']==3].copy()
topic_perf = df_r3.groupby('topic')['consensus_score'].agg(['mean','std']).reset_index()
topic_perf.columns = ['Topic', 'Mean Consensus', 'Std Dev']
topic_top5 = topic_perf.nlargest(5, 'Mean Consensus')
topic_bottom5 = topic_perf.nsmallest(5, 'Mean Consensus')

print("\n## Table 3a: Top 5 Topics (Round 3 Consensus)\n")
print(topic_top5.to_markdown(index=False))
print("\n## Table 3b: Bottom 5 Topics (Round 3 Consensus)\n")
print(topic_bottom5.to_markdown(index=False))

# ------------------------------------------------------------
# Table 4: Combined metrics – latency vs. quality trade‑off
# ------------------------------------------------------------
combined = df.groupby(['model_short', 'round']).agg(
    Consensus=('consensus_score', 'mean'),
    Faithfulness=('faithfulness', 'mean'),
    Latency_s=('duration_seconds', 'mean')
).round({'Consensus':1, 'Faithfulness':3, 'Latency_s':1}).reset_index()

print("\n## Table 4: Mean Metrics – Quality vs. Latency Trade‑off\n")
print(combined.to_markdown(index=False))

# Optional: save tables as CSV files
table1.to_csv("tables/table1.csv", index=False)
improvement.to_csv("tables/table2.csv", index=False)
topic_top5.to_csv("tables/table3_top5.csv", index=False)
topic_bottom5.to_csv("tables/table3_bottom5.csv", index=False)
combined.to_csv("tables/table4.csv", index=False)
