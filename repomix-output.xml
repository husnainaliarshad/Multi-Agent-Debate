import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Load data
df = pd.read_csv("realistic_benchmarking_experiment_450.csv")

# Convert round from mode column
df['round'] = df['mode'].str.extract(r'(\d+)').astype(int)

# Map model names for cleaner labels
model_names = {
    'lfm2.5-350m': 'LFM 350M',
    'qwen2.5-0.5b-instruct': 'Qwen 0.5B',
    'llama3.2-1b-instruct': 'Llama 3.2 1B'
}
df['model_short'] = df['proposer_model'].map(model_names)

# Set style
sns.set_style("whitegrid")
plt.rcParams['figure.figsize'] = (10, 6)
plt.rcParams['font.size'] = 12

# ========== 1. Consensus by model and round ==========
plt.figure()
sns.boxplot(data=df, x='round', y='consensus_score', hue='model_short')
plt.title('Consensus Score by Debate Round and Model')
plt.ylabel('Consensus Score (%)')
plt.xlabel('Debate Rounds')
plt.tight_layout()
plt.savefig('figures/consensus_by_round_model.png', dpi=150)
plt.close()

# ========== 2. Faithfulness by round and model ==========
plt.figure()
sns.boxplot(data=df, x='round', y='faithfulness', hue='model_short')
plt.title('Faithfulness (GBR) by Debate Round and Model')
plt.ylabel('Faithfulness Score')
plt.xlabel('Debate Rounds')
plt.tight_layout()
plt.savefig('figures/faithfulness_by_round_model.png', dpi=150)
plt.close()

# ========== 3. Latency scaling (mean per round & model) ==========
latency_mean = df.groupby(['model_short', 'round'])['duration_seconds'].mean().reset_index()
plt.figure()
sns.barplot(data=latency_mean, x='model_short', y='duration_seconds', hue='round', palette='viridis')
plt.title('Average Latency per Debate Round')
plt.ylabel('Duration (seconds)')
plt.xlabel('Model')
plt.legend(title='Rounds')
plt.tight_layout()
plt.savefig('figures/latency_by_round_model.png', dpi=150)
plt.close()

# ========== 4. Consensus improvement (R1 vs R3) ==========
improvement = df[df['round'].isin([1,3])].groupby(['model_short', 'round'])['consensus_score'].mean().unstack()
improvement.columns = improvement.columns.astype(int)  # ensure integers
improvement['Gain'] = improvement[3] - improvement[1]
plt.figure()
# Use integer column names
improvement[[1, 3]].plot(kind='bar', ylabel='Consensus Score (%)', title='Average Consensus: Round 1 vs Round 3')
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig('figures/consensus_r1_vs_r3.png', dpi=150)
plt.close()

# ========== 5. Faithfulness by topic (top 10 topics by variance) ==========
# Use only round 3 for clarity
df_r3 = df[df['round'] == 3]
topic_faith = df_r3.groupby('topic')['faithfulness'].mean().sort_values(ascending=False).head(10)
plt.figure()
topic_faith.plot(kind='barh')
plt.xlabel('Average Faithfulness (Round 3)')
plt.title('Top 10 Topics by Faithfulness (3 rounds)')
plt.tight_layout()
plt.savefig('figures/faithfulness_topics.png', dpi=150)
plt.close()

# ========== 6. Correlation: Consensus vs Faithfulness (scatter, colored by round) ==========
plt.figure()
sns.scatterplot(data=df, x='consensus_score', y='faithfulness', hue='round', alpha=0.6)
plt.xlabel('Consensus Score (%)')
plt.ylabel('Faithfulness')
plt.title('Correlation between Consensus and Faithfulness')
plt.legend(title='Debate Rounds')
plt.tight_layout()
plt.savefig('figures/consensus_faithfulness_correlation.png', dpi=150)
plt.close()

# ========== 7. Supplementary: boxplots of consensus per topic (top 10 topics round 3) ==========
top_topics = df_r3.groupby('topic')['consensus_score'].mean().nlargest(10).index
df_top_topics = df_r3[df_r3['topic'].isin(top_topics)]
plt.figure(figsize=(12, 6))
sns.boxplot(data=df_top_topics, x='consensus_score', y='topic', orient='h')
plt.xlabel('Consensus Score (%) - Round 3')
plt.title('Consensus Distribution for Top 10 Performing Topics')
plt.tight_layout()
plt.savefig('figures/consensus_topics_boxplot.png', dpi=150)
plt.close()

print("All plots generated successfully.")y
